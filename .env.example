# ---- LLM fallback chain (tier order = GEMINI -> GROQ -> DEEPSEEK -> OPENROUTER) ----
# Any tier without a key is skipped. With no keys at all the pipeline still runs
# using deterministic rules only (extraction_method = "rules").
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---- Data source credentials ----
# GitHub token (no scopes needed) -> live star counts via GraphQL, 5,000 req/h.
GITHUB_TOKEN=
# Optional: Product Hunt developer token (adds a second product source).
PRODUCT_HUNT_TOKEN=

# ---- Crawler tuning ----
HTTP_CONCURRENCY=64
PER_HOST_CONCURRENCY=4
PER_HOST_RPS=2
REQUEST_TIMEOUT=25
MAX_RETRIES=4
LLM_CONCURRENCY=8
# http(s) proxy or rotating residential gateway, e.g. http://user:pass@gw.example:8000
PROXY_URL=
# Escalate Cloudflare/DataDome challenge pages to a real headless Chromium
BROWSER_FALLBACK=true
BROWSER_CONCURRENCY=4
RESPECT_ROBOTS=true

# ---- State backend: sqlite (single node) | redis (distributed crawler nodes) ----
STATE_BACKEND=sqlite
REDIS_URL=redis://localhost:6379/0

# ---- Targets ----
TARGET_STARTUPS=1000
TARGET_PRODUCTS=1000
TARGET_PAPERS=1000
FRESHNESS_HOURS=24

# ---- Google Sheets export (optional) ----
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_ID=

LOG_LEVEL=INFO
LOG_FORMAT=pretty
